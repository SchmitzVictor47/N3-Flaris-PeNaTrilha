# Destino da carga. Padrão: o MongoDB do docker-compose.
# Para carregar no MongoDB Atlas do app, use a mesma URI do backend:
# MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/penatrilha
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=penatrilha

# Opcional: credenciais da Kaggle API (kaggle.com > Settings > API > Create New Token).
# Sem elas, a captura usa o endpoint público de download da mesma API.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Memória do driver do Spark (o Docker precisa de pelo menos 6 GB livres)
SPARK_DRIVER_MEMORY=3g

# Só no Linux: use o seu UID para os relatórios serem gravados na pasta do projeto (id -u)
AIRFLOW_UID=50000
